{
  "$comment": "Copy this file outside the repo and edit it. Configs hold env-var NAMES only, never keys. Prices are USD per million tokens; leave pricing out when unknown and receipts record usdEstimate: null. Model ids and base URLs here are examples to replace with what you actually run.",
  "systems": [
    {
      "id": "mock",
      "type": "mock",
      "variant": "faithful"
    },
    {
      "id": "frontier",
      "type": "openai-compatible",
      "baseUrl": "https://ai-gateway.vercel.sh/v1",
      "model": "provider/frontier-model-id",
      "apiKeyEnv": "AI_GATEWAY_API_KEY",
      "maxTokens": 4096,
      "temperature": 0.8
    },
    {
      "id": "hybrid",
      "type": "hybrid",
      "planner": {
        "baseUrl": "https://ai-gateway.vercel.sh/v1",
        "model": "provider/frontier-model-id",
        "apiKeyEnv": "AI_GATEWAY_API_KEY"
      },
      "writer": {
        "baseUrl": "https://ai-gateway.vercel.sh/v1",
        "model": "provider/other-frontier-model-id",
        "apiKeyEnv": "AI_GATEWAY_API_KEY"
      }
    },
    {
      "id": "hybrid-arcanea",
      "type": "hybrid-arcanea",
      "chapters": 3,
      "planner": {
        "baseUrl": "https://ai-gateway.vercel.sh/v1",
        "model": "provider/frontier-model-id",
        "apiKeyEnv": "AI_GATEWAY_API_KEY",
        "maxTokens": 8192,
        "temperature": 0.7
      },
      "extractor": {
        "type": "workers-ai",
        "model": "@cf/deepseek-ai/deepseek-v4.1-flash-1017"
      },
      "continuity": {
        "stopOnError": false
      }
    }
  ],
  "judges": {
    "provider": "workers-ai",
    "models": [
      "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
      "@cf/openai/gpt-oss-120b"
    ],
    "spreadThreshold": 3
  },
  "safetyClassifier": {
    "type": "workers-ai",
    "model": "@cf/meta/llama-guard-3-8b"
  }
}
