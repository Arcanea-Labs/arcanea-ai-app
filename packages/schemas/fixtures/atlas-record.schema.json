{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "logicalId": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "branchId": {
      "type": "string"
    },
    "validFrom": {
      "type": "number"
    },
    "validTo": {
      "type": [
        "number",
        "null"
      ]
    },
    "recordedFrom": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "recordedTo": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revealChapter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "chapterTitle": {
      "type": "string"
    },
    "chapterHref": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "audience": {
      "type": "string",
      "enum": [
        "reader",
        "character",
        "author"
      ]
    },
    "knownBy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "provisional",
        "synthetic"
      ]
    },
    "fact": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "position"
            },
            "entityId": {
              "type": "string"
            },
            "locationId": {
              "type": "string"
            },
            "viaPortalId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "entityId",
            "locationId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "assertion"
            },
            "entityId": {
              "type": "string"
            },
            "predicate": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "entityId",
            "predicate",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "observation"
            },
            "observerId": {
              "type": "string"
            },
            "entityId": {
              "type": "string"
            },
            "predicate": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "observerId",
            "entityId",
            "predicate",
            "value",
            "confidence"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "id",
    "logicalId",
    "revision",
    "branchId",
    "validFrom",
    "validTo",
    "recordedFrom",
    "recordedTo",
    "revealChapter",
    "chapterTitle",
    "chapterHref",
    "title",
    "detail",
    "audience",
    "knownBy",
    "sourceIds",
    "status",
    "fact"
  ],
  "additionalProperties": false
}
